<Window x:Class="MinecraftSsForensics.Scanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft SS Forensics — Standalone Windows Forensic Scanner &amp; Report Viewer" 
        Height="780" Width="1040"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17" Foreground="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0B0F17"/>
        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1F2937"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentSky" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SkyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header with Mode Switcher -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Workflow Mode Switcher -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ MINECRAFT SS FORENSICS" FontSize="17" FontWeight="Bold" Foreground="#34D399"/>
                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STANDALONE EDITION v2.0" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Open-source, evidence-based Minecraft screenshare forensics for Windows • Zero server dependencies" 
                               FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Workflow Selector: Player vs Staff -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbModePlayer" Content="👤 Player Scan Mode" IsChecked="True" 
                                 Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"
                                 Checked="WorkflowMode_Changed"/>
                    <RadioButton x:Name="RbModeStaff" Content="🔍 Staff Report Viewer" 
                                 Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12"
                                 Checked="WorkflowMode_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- ======================================================== -->
            <!-- 1. VIEW: Player Consent & Audit Configuration            -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="PanelPlayerConsent" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    
                    <!-- Purpose and Scope Notice -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Audit Scope and Legal Consent Notice" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="18">
                                This application collects scoped forensic telemetry on Windows to verify client integrity for competitive Minecraft play.
                                It performs local, read-only inspection of game installations, running processes, loaded DLLs, execution artifacts, and mod hashes.
                                <LineBreak/><LineBreak/>
                                • Zero server upload: Reports are generated entirely on your machine.<LineBreak/>
                                • Privacy guarantee: Never collects passwords, session tokens, personal photos, or personal browser history.<LineBreak/>
                                • You decide where to save your report file (.json and .html) and can inspect every piece of evidence before sharing with staff.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Selectable Audit Categories -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Audit Categories to Inspect" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkMods" Content="Minecraft Mod JARs &amp; Hashes" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ChkProcesses" Content="Processes &amp; Modules (javaw.exe)" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ChkExecution" Content="Execution Artifacts (Prefetch/BAM)" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ChkRegistry" Content="Windows Registry (UserAssist/PCA)" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ChkUsb" Content="USB Storage Devices (USBSTOR)" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                                <CheckBox x:Name="ChkDiscovery" Content="Staging Folders (Downloads/Desktop)" IsChecked="True" Foreground="#E2E8F0" FontSize="11" Margin="0,0,18,8"/>
                            </WrapPanel>

                            <!-- Explicitly Optional Sensitive Category -->
                            <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkBrowser" Content="Optional Sensitive Audit: Known Cheat Domains in Browser History" 
                                              IsChecked="False" Foreground="#C7D2FE" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Text="Audits Chrome/Edge history strictly for visits matching known cheat distribution portals (e.g. vape.gg, doomsdayclient.com). Strictly NEVER accesses search queries, passwords, cookies, or unrelated web pages."
                                               Foreground="#A5B4FC" FontSize="10" TextWrapping="Wrap" Margin="22,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Competitive Gamemode Policy Rulebook -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Competitive Gamemode &amp; Policy Rulebook" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Text="Authenticity and gameplay policy are evaluated independently. Select the server's ruleset:" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbGamemode" Height="28" Background="#0F172A" Foreground="#E2E8F0" SelectedIndex="0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Crystal PvP (End Crystal Combat Ruleset)"/>
                                <ComboBoxItem Content="Sword PvP (1.8 / 1.9+ Sword Duels Ruleset)"/>
                                <ComboBoxItem Content="Axe PvP (Axe &amp; Shield Ruleset)"/>
                                <ComboBoxItem Content="UHC (Ultra Hardcore Survival Ruleset)"/>
                                <ComboBoxItem Content="Pot PvP (Nodebuff &amp; Potion Ruleset)"/>
                                <ComboBoxItem Content="SMP (Survival Multiplayer &amp; Technical Vanilla+)"/>
                                <ComboBoxItem Content="Default (General Competitive Standard)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Scan Mode & Custom Folder -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Scan Mode &amp; Target Directory" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RbQuick" Content="Quick Scan (Recommended)" IsChecked="True" Foreground="#F1F5F9" FontSize="11" Margin="0,0,20,0"/>
                                <RadioButton x:Name="RbFull" Content="Full Scan (Deep History &amp; Registry)" Foreground="#F1F5F9" FontSize="11"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCustomDir" Height="28" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Padding="6,4" FontSize="11" VerticalContentAlignment="Center"
                                         Text="" ToolTip="Leave blank for automatic Minecraft client discovery"/>
                                <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Height="28" Click="BtnBrowseDir_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Explicit Consent Checkbox -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <CheckBox x:Name="ChkExplicitConsent" Checked="ChkConsent_Changed" Unchecked="ChkConsent_Changed">
                            <TextBlock TextWrapping="Wrap" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0">
                                I give explicit consent to perform the forensic audit categories selected above and generate a local report.
                            </TextBlock>
                        </CheckBox>
                    </Border>

                    <Button x:Name="BtnStartScan" Style="{StaticResource PrimaryButton}" Height="38" FontSize="13"
                            Content="▶ Start Standalone Forensic Scan" IsEnabled="False" Click="BtnStartScan_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 2. VIEW: Scanning Progress View                         -->
            <!-- ======================================================== -->
            <Border x:Name="PanelPlayerScanning" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="28" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <TextBlock x:Name="LblScanCategory" Text="Scanning in Progress..." FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="ProgScanBar" Height="8" Minimum="0" Maximum="100" Value="10" Width="380" Foreground="#10B981" Background="#0F172A" BorderBrush="#334155" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LblScanAction" Text="Discovering game folders and hashing mod archives..." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18"/>
                    <Button x:Name="BtnCancelScan" Content="Cancel Scan" Width="120" HorizontalAlignment="Center" Click="BtnCancelScan_Click"/>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- 3. VIEW: Player Scan Results & Local Export             -->
            <!-- ======================================================== -->
            <ScrollViewer x:Name="PanelPlayerResults" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <!-- Verdict Card -->
                    <Border x:Name="CardVerdict" Background="#064E3B" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="LblVerdictTitle" Text="✔ NO EVIDENCE OF CHEATING DETECTED" FontWeight="Bold" Foreground="#6EE7B7" FontSize="14"/>
                            <TextBlock x:Name="LblVerdictDesc" Text="No confirmed cheat software or prohibited mod artifacts discovered." Foreground="#A7F3D0" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary Metrics Grid -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#111827" Padding="10" CornerRadius="6" Margin="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Total Checks" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtResChecks" Text="0" FontSize="16" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#111827" Padding="10" CornerRadius="6" Margin="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Passed" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtResPassed" Text="0" FontSize="16" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#111827" Padding="10" CornerRadius="6" Margin="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Findings" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtResFindings" Text="0" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="#111827" Padding="10" CornerRadius="6" Margin="3">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Verified Mods" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtResMods" Text="0" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Findings Quick Preview -->
                    <TextBlock Text="Discovered Findings Preview:" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,4,0,6"/>
                    <ListBox x:Name="LstPlayerFindings" MaxHeight="160" Background="#111827" BorderBrush="#1F2937" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,16"/>

                    <!-- Local Export Save Buttons -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Save Forensic Report for Server Staff" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                            <TextBlock Text="Choose where to save your portable report files on your computer. You can provide either the JSON evidence file or the standalone HTML report directly to staff." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSaveJson" Grid.Column="0" Content="💾 Save JSON Report (.json)" Style="{StaticResource PrimaryButton}" Height="34" Click="BtnSaveJson_Click"/>
                                <Button x:Name="BtnSaveHtml" Grid.Column="2" Content="🌐 Save HTML Report (.html)" Style="{StaticResource SkyButton}" Height="34" Click="BtnSaveHtml_Click"/>
                                <Button x:Name="BtnSaveMd" Grid.Column="4" Content="📝 Save Markdown (.md)" Height="34" Click="BtnSaveMd_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnPlayerNewScan" Content="Start New Scan" HorizontalAlignment="Right" Width="140" Click="BtnNewScan_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!-- 4. VIEW: Standalone Staff Report Viewer                  -->
            <!-- ======================================================== -->
            <Grid x:Name="PanelStaffViewer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Staff Toolbar (Open File, Seal verification) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Viewer Content Split -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Staff Toolbar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnOpenReportFile" Content="📂 Open Report File (.json)..." Style="{StaticResource SkyButton}" Height="30" Click="BtnOpenReportFile_Click"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Report: " Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock x:Name="TxtStaffReportId" Text="No report loaded" FontWeight="Bold" Foreground="#F1F5F9" FontSize="11" Margin="0,0,14,0"/>
                            <Border x:Name="BadgeSealStatus" Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSealStatus" Text="Awaiting Report" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BtnStaffExportHtml" Grid.Column="2" Content="🌐 Open in Browser (HTML)" Height="30" Click="BtnStaffExportHtml_Click"/>
                    </Grid>
                </Border>

                <!-- Staff Report Explorer Split View -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Findings & Category Filters -->
                    <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Discovered Findings" FontWeight="Bold" Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,8"/>

                            <!-- Filter & Search -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBox x:Name="TxtStaffSearch" Height="26" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Padding="4,2" FontSize="11"
                                         TextChanged="TxtStaffSearch_TextChanged" Margin="0,0,0,6"/>
                                <ComboBox x:Name="CmbStaffFilterClass" Height="26" Background="#0F172A" Foreground="#E2E8F0" SelectedIndex="0" SelectionChanged="CmbStaffFilter_Changed">
                                    <ComboBoxItem Content="All Classifications"/>
                                    <ComboBoxItem Content="Confirmed Cheats Only"/>
                                    <ComboBoxItem Content="Strong Indicators"/>
                                    <ComboBoxItem Content="Suspicious Findings"/>
                                    <ComboBoxItem Content="Needs Review"/>
                                    <ComboBoxItem Content="Informational"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Findings List -->
                            <ListBox x:Name="LstStaffFindings" Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" Foreground="#E2E8F0" FontSize="11"
                                     SelectionChanged="LstStaffFindings_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <!-- Grid Splitter -->
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                    <!-- Right: Finding Inspection & Evidence Tabs -->
                    <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelFindingDetail">
                                <TextBlock x:Name="TxtDetailTitle" Text="Select a finding on the left to inspect forensic evidence." FontSize="14" FontWeight="Bold" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtDetailMeta" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,12"/>

                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="What Was Observed:" FontWeight="Bold" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtDetailExplanation" Text="No finding selected." Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0F172A" Padding="8" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Why it matters:" FontWeight="Bold" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtDetailWhy" Text="-" Foreground="#E2E8F0" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#0F172A" Padding="8" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="Alternative explanations:" FontWeight="Bold" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TxtDetailAlt" Text="-" Foreground="#E2E8F0" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtDetailNotProven" Text="What is NOT proven: -" Foreground="#C7D2FE" FontSize="10" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Supporting File &amp; Technical Details:" FontWeight="Bold" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDetailRawProps" IsReadOnly="True" MaxHeight="140" Background="#030712" Foreground="#34D399" FontFamily="Consolas" FontSize="10" Padding="8"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,6,0,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblStatus" Text="Ready. Review audit scope to begin player scan, or switch to Staff Report Viewer." FontSize="11" Foreground="#94A3B8"/>
                <TextBlock Text="Standalone Windows Edition • No Cloud Dependency" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
