<Window x:Class="MinecraftSsForensics.Scanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft SS Forensics — Forensic Evidence Scanner" 
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17" Foreground="#F1F5F9"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <!-- Dark Theme Colors & Styles -->
        <SolidColorBrush x:Key="BgDark" Color="#0B0F17"/>
        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorder" Color="#1F2937"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentEmeraldHover" Color="#059669"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area (Card) -->
            <RowDefinition Height="*"/>
            <!-- Footer Status -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MINECRAFT SS FORENSICS" FontSize="18" FontWeight="Bold" Foreground="#34D399"/>
                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="STAGE 2 SCANNER" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Consented, read-only Minecraft screenshare diagnostic evidence collector" 
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="API Endpoint:" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtApiUrl" Text="http://localhost:5000" Width="145" Height="24" 
                                 Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Padding="4,2" FontSize="11" VerticalContentAlignment="Center"
                                 ToolTip="Backend API URL for ingestion (default http://localhost:5000)"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Web Viewer URL:" Foreground="#94A3B8" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtFrontendUrl" Text="http://localhost:3000" Width="145" Height="24" 
                                 Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Padding="4,2" FontSize="11" VerticalContentAlignment="Center"
                                 ToolTip="Public Frontend dashboard URL for staff viewing (default http://localhost:3000)"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Panels Container -->
        <Grid Grid.Row="1">
            <!-- 1. VIEW: Consent & Setup -->
            <ScrollViewer x:Name="PanelConsent" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                <StackPanel Margin="0,0,12,0">
                    <!-- Scope Notice Card -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Forensic Evidence Collection Scope &amp; Disclosure" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12" LineHeight="18">
                                This scanner conducts a read-only inspection of your Minecraft environment to assist server anti-cheat staff. It operates in normal user mode and does not require administrator privileges.
                            </TextBlock>
                            
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="✔ What IS Inspected:" FontWeight="Bold" Foreground="#34D399" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Minecraft installations &amp; mods (.jar) folders" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Cryptographic hashes of discovered mod archives" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Verification against Modrinth &amp; CurseForge releases" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Active Minecraft javaw.exe process and loaded modules" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Recent game session logs (latest.log)" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="✖ What IS NOT Inspected:" FontWeight="Bold" Foreground="#F87171" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Personal documents, photos, or unrelated folders" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Browser history, cookies, or stored passwords" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Memory dumps of unrelated applications" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• Whole JAR files are NEVER uploaded (hashes only)" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="• No background agents or persistent drivers installed" Foreground="#94A3B8" FontSize="11" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacy &amp; Deletion Rights:" FontWeight="Bold" Foreground="#A5B4FC" FontSize="12"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#C7D2FE" FontSize="11" Margin="0,4,0,0">
                                        Anyone with the resulting share link can view the diagnostic report. Reports automatically expire in 7 days. You will receive a separate private Deletion Key to permanently wipe the report from the server at any time.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Scan Mode Selection -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Select Scan Mode" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <RadioButton x:Name="RbQuickScan" IsChecked="True" GroupName="ScanMode" Margin="0,4">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Quick Scan (Recommended)" FontWeight="Bold" Foreground="#F1F5F9" FontSize="12"/>
                                    <TextBlock Text="Discovers game folders, hashes mod JARs, checks Modrinth/CurseForge releases, inspects running javaw.exe modules." Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RbFullScan" GroupName="ScanMode" Margin="0,8,0,0">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="Full Scan" FontWeight="Bold" Foreground="#F1F5F9" FontSize="12"/>
                                    <TextBlock Text="Everything in Quick Scan plus Windows Prefetch checks, Temp directory inspection, and deeper timeline correlation." Foreground="#94A3B8" FontSize="11"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Optional Custom Directory -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Custom Minecraft Directory (Optional):" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomPath" Height="28" Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#334155" Padding="6,4" FontSize="11" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnBrowsePath" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Height="28" Click="BtnBrowsePath_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Consent Confirmation -->
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="ChkConsent" Checked="ChkConsent_Changed" Unchecked="ChkConsent_Changed">
                                <TextBlock TextWrapping="Wrap" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0">
                                    I give explicit consent to collect the scoped Minecraft diagnostic forensic evidence stated above.
                                </TextBlock>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <Button x:Name="BtnStartScan" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14"
                            Content="Start Forensic Scan" IsEnabled="False" Click="BtnStartScan_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. VIEW: Scanning In Progress -->
            <Border x:Name="PanelScanning" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                    <TextBlock x:Name="TxtScanCategory" Text="Initializing Scanner..." FontSize="16" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtScanAction" Text="Preparing filesystem inspection..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    
                    <ProgressBar x:Name="PrgScan" Height="14" Value="0" Maximum="100" Margin="0,0,0,16" Background="#0F172A" Foreground="#10B981" BorderBrush="#334155"/>

                    <!-- Metric Counters Grid -->
                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <Border Background="#0F172A" Padding="12" CornerRadius="6" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Discovered Mods" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LblDiscoveredCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" Padding="12" CornerRadius="6" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Verified Releases" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LblVerifiedCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" Padding="12" CornerRadius="6" Margin="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Flagged Indicators" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LblFlaggedCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button x:Name="BtnCancelScan" Content="Cancel Scan" Width="140" HorizontalAlignment="Center" Click="BtnCancelScan_Click"/>
                </StackPanel>
            </Border>

            <!-- 3. VIEW: Report Review Before Upload -->
            <ScrollViewer x:Name="PanelReview" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Scan Complete — Review Report Before Submitting" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,4"/>
                            <TextBlock Text="Verify the gathered diagnostic evidence before transmitting it to the reporting server." Foreground="#94A3B8" FontSize="12" Margin="0,0,0,14"/>

                            <!-- Summary Metrics -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0F172A" Padding="12" CornerRadius="6" Margin="3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Scan Mode" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RevScanMode" Text="QUICK" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#0F172A" Padding="12" CornerRadius="6" Margin="3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Total Checks" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RevTotalChecks" Text="0" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#0F172A" Padding="12" CornerRadius="6" Margin="3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Passed Checks" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RevPassedChecks" Text="0" FontSize="14" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#0F172A" Padding="12" CornerRadius="6" Margin="3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Flagged Findings" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RevFlaggedFindings" Text="0" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Findings Quick List -->
                            <TextBlock Text="Discovered Findings &amp; Evidence Records:" FontWeight="Bold" Foreground="#E2E8F0" FontSize="12" Margin="0,6,0,6"/>
                            <ListBox x:Name="LstFindingsPreview" MaxHeight="180" Background="#0F172A" BorderBrush="#1E293B" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,12"/>

                            <!-- Raw JSON Accordion -->
                            <Expander Header="View Raw Ingestion Payload JSON" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,14">
                                <TextBox x:Name="TxtRawJsonPreview" IsReadOnly="True" MaxHeight="220" 
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#030712" Foreground="#34D399" FontFamily="Consolas, Courier New" FontSize="11" Padding="8"/>
                            </Expander>

                            <!-- Action Buttons -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button x:Name="BtnDiscardScan" Grid.Column="0" Content="Discard &amp; Start Over" Click="BtnDiscardScan_Click"/>
                                <Button x:Name="BtnConfirmUpload" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Confirm &amp; Upload Report to Server" Click="BtnConfirmUpload_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. VIEW: Uploading Spinner -->
            <Border x:Name="PanelUploading" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Uploading Report to Backend..." FontSize="16" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar Height="4" IsIndeterminate="True" Width="260" Foreground="#38BDF8" Background="#0F172A" BorderBrush="#334155" Margin="0,0,0,16"/>
                    <TextBlock Text="Transmitting structured forensic evidence and verifying cryptographic payload..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 5. VIEW: Upload Result (Share URL & Deletion Key) -->
            <ScrollViewer x:Name="PanelResult" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="0,0,12,0">
                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Success Banner -->
                            <Border Background="#064E3B" CornerRadius="6" Padding="14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="✔ Report Successfully Uploaded &amp; Validated!" FontWeight="Bold" Foreground="#6EE7B7" FontSize="14"/>
                                    <TextBlock x:Name="LblResultMessage" Text="Report successfully ingested." Foreground="#A7F3D0" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Share URL Box -->
                            <TextBlock Text="1. Public Shareable Report Link (Send this URL to Staff):" FontWeight="Bold" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,6"/>
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtShareUrl" IsReadOnly="True" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" 
                                             FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCopyShareUrl" Grid.Column="1" Content="Copy Link" Margin="8,0,0,0" Click="BtnCopyShareUrl_Click"/>
                                    <Button x:Name="BtnOpenInBrowser" Grid.Column="2" Content="Open in Browser" Margin="6,0,0,0" Click="BtnOpenInBrowser_Click"/>
                                </Grid>
                            </Border>

                            <!-- Deletion Key Box -->
                            <TextBlock Text="2. Secret Deletion Key (KEEP PRIVATE — DO NOT SEND TO STAFF):" FontWeight="Bold" Foreground="#F59E0B" FontSize="13" Margin="0,0,0,6"/>
                            <Border Background="#0F172A" BorderBrush="#78350F" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDeletionKey" IsReadOnly="True" Background="Transparent" Foreground="#FCD34D" BorderThickness="0" 
                                             FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnCopyDeletionKey" Grid.Column="1" Content="Copy Key" Margin="8,0,0,0" Click="BtnCopyDeletionKey_Click"/>
                                </Grid>
                            </Border>

                            <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,20">
                                ℹ Staff open the public share link in their browser to review findings. Your private deletion key stays with you and is never shown in the public link or staff view.
                            </TextBlock>

                            <!-- Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnDeleteReportNow" Grid.Column="0" Style="{StaticResource DangerButton}" Content="Delete Report from Server Now" Click="BtnDeleteReportNow_Click"/>
                                <Button x:Name="BtnNewScan" Grid.Column="2" Content="Start New Scan" Click="BtnNewScan_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,8,0,0" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="LblStatus" Text="Ready to scan. Please review the scope and consent to begin." FontSize="11" Foreground="#94A3B8"/>
                <TextBlock Text="Open-Source Forensics • Normal User-Mode Execution" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
