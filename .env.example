# ===================================================================
# Minecraft SS Forensics — Environment Configuration Example
# ===================================================================

# ASP.NET Core Runtime Environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
# Options: "PostgreSql" or "Sqlite"
DATABASE__PROVIDER=Sqlite

# PostgreSQL Connection String (used when DATABASE__PROVIDER=PostgreSql)
DATABASE__POSTGRESQLCONNECTIONSTRING=Host=localhost;Port=5432;Database=minecraft_ss_forensics;Username=postgres;Password=your_secure_password_here

# SQLite Connection String (used for zero-dependency local dev / testing)
DATABASE__SQLITECONNECTIONSTRING=Data Source=App_Data/forensics.db

# Security & Cryptographic Salts
# IMPORTANT: Provide a random high-entropy salt string in production!
SECURITY__HASH_SALT=your_secret_cryptographic_hash_salt_here

# Storage Directory for Raw Evidence Files
STORAGE__EVIDENCE_DIRECTORY=App_Data/evidence_storage

# Frontend Environment
VITE_API_URL=http://localhost:5000
